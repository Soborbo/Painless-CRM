root = true

# Keep line endings LF everywhere so Biome's formatter (pnpm lint) stays
# meaningful on Windows checkouts (core.autocrlf=true). Mirrors the repo-root
# .gitattributes (`* text=auto eol=lf`).
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
